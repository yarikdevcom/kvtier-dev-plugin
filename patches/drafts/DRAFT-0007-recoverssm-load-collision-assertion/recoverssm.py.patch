+class RecoverSSMLoadCollisionError(RuntimeError):
+    """A RecoverSSM state commit and a connector KV load claim one block.
+
+    The message always opens with the constant phrase below so an operator
+    reading a crash can tell this collision from every other assertion in this
+    file (and from a torch/Triton index error, which is what a raw `assert`
+    would have produced - and a raw `assert` also vanishes under `python -O`,
+    which is why this is a real exception type).
+
+    Both orders of this collision answer the prompt and neither raises
+    anywhere else in the engine: the deferred commit overwrites state a load
+    just restored with one derived from a checkpoint that predates the load,
+    or the load overwrites a state the commit had already advanced. A fluent
+    continuation is the failure, so the engine must stop here instead.
+    """
+
+    MARKER = "RECOVERSSM/KV-CONNECTOR STATE COLLISION"
+
+
