# DRAFT - **DO NOT APPLY** (it has never been applied or graded on a boot; that is
# the remaining gate, not the wiring). STATUS 2026-10-22: the inertness this header
# used to announce is CLOSED. `kv_connector.py.patch` and `model_runner.py.patch`
# (this directory) call the publish at the connector's load submit, register the
# guard's other half at the model runner's connector construction site, and un-publish
# when the engine proves a transfer is over. The in-flight set is no longer empty by
# construction, `guard_armed()` is reachable, and a collision would raise. What the
# draft still is: UNGRADED. No boot has ever run all four hunks, no planted-word
# request has ever been graded against a recomputed answer, and the witness the guard
# writes has no reader inside the plugin yet. See "WHAT IS MISSING" and promotion
# items 4 and 5.
#
# WHY IT LIVES HERE AND NOT IN `patches/0007-...`: `apply-kvtier-patches.sh` dies on any
# `[0-9][0-9][0-9][0-9]-*/` directory the `series` file does not list ("an unlisted patch
# is a patch nobody applies"), and `tests/test_patch_series.py` asserts `entries ==
# on_disk`. A numbered draft directory would break both - a draft that is not ready would
# disable the tool that keeps the engine honest. `drafts/` is invisible to both.
#
# WHAT MUST BE TRUE BEFORE PROMOTION, in the order they will be checked:
#   1. THE LOAD-SIDE PUBLISH HUNK EXISTS. **SATISFIED 2026-10-22** by
#      `kv_connector.py.patch` (+ the one-line registration in
#      `model_runner.py.patch`). `publish_inflight_load_blocks` now has a caller on
#      the submit path and a matching un-publish on the completion path; a load
#      submit without a publish, or a publish without an un-publish, fails
#      `tests/test_recoverssm_guard_wiring.py`. What that file CANNOT do is reach
#      the three call sites behaviourally (they are one line each inside methods
#      that need a connector, a forward context and a GPU), so those three are
#      STRUCTURAL tests that parse the shipped hunk - weaker than a behavioural
#      test, labelled as such where they are defined, and verified to fail when
#      the publish line is deleted from the patch (checked by mutation: removing
#      it fails exactly one test). Inert-by-accident is now a test failure instead
#      of a manifest sentence.
#   2. THE TOOL CAN EXPRESS IT. `patch.manifest` describes ONE target file and ONE
#      `klass`; this entry is two files and wants to be three - and is now FOUR
#      (`kv_connector.py.patch`, `model_runner.py.patch`). Either it splits into
#      entries with a declared order, or `kvtier-patch.sh` grows multi-file support -
#      which is a change to the tool and to its own test, not to this manifest. The
#      order is not free: `model_runner.py.patch` and `kv_connector.py.patch` must
#      land together (a connector with no registrant never arms, and a registrant
#      calling a method the connector does not have is a boot-time AttributeError),
#      and both must precede nothing - they are independent of the other two files.
#      The four records below are therefore written as COMMENTED key blocks, not as
#      live keys: the manifest is shell-sourced, and a second live
#      `tree_v2_5_1_target_abs=` line would let the last assignment win and silently
#      re-point the primary entry at the wrong file.
#   3. THE RESIDUAL PP=2 QUESTION IS ANSWERED THE ONLY WAY IT CAN BE. This draft exists to
#      convert that question from SILENT to LOUD; it does not answer it. See "THE
#      RESIDUAL QUESTION". A guard that can fire is the precondition for the answer,
#      because nothing else in the stack will ever notice the collision.
#   4. THE ACCEPTANCE BOOT IS GRADED, NOT OBSERVED. Both flags on one boot
#      (`--use-replayssm` + our connector), a `kvtier_disk_restore`-flagged request on a
#      prompt with a planted code word, graded on greedy equality against the recomputed
#      answer - never on `offers`/`adopted`/`reads_applied`. The guard must stay SILENT on
#      it, and a synthetic collision injected into the same build must RAISE. Silence
#      without the injected positive is an untested guard.
#   5. `kvtier-patch.sh verify` re-reads every fingerprint below with the ENGINE
#      interpreter against the real tree, and agrees.

draft_id=recoverssm-load-collision-assertion
title="v2.5.1: raise, do not guess, when a RecoverSSM state commit and a connector KV load claim the same block"
upstream_issue="none (fork-local; the mechanisms are the fork's, patches 0071/0072/0085/0091)"
upstream_pr="none (fork-local)"

# ---- WHAT THIS IS, IN ONE PARAGRAPH ----------------------------------------
# DRAFT-0006 asks the fork to LIFT a refusal (`validate_mamba_cached_kernel`'s last
# clause, which vetoes `--use-replayssm` + any KV connector, and fires on us because
# `serve-v2.2.sh` passes `kv_role: "kv_both"`). Lifting a refusal grants a PERMISSION.
# This entry is the thing that has to exist beside the permission: an ASSERTION. The
# research pass that read the clause's history found it is conservatism, not a
# documented interaction - one commit owns the string (`ced6857`, a tree-wide import
# squash with no attributable reason) and the ~40 fork commits on top never touch it or
# name a connector. Conservatism is liftable. The failure mode underneath it is not, and
# it is the reason a guard beats a permission: if the two mechanisms' step orderings ever
# do collide, BOTH outcomes produce a fluent continuation and no exception anywhere - the
# deferred RecoverSSM commit overwrites state a load just restored with one derived from a
# checkpoint that predates the load, or the load overwrites a state the commit had already
# advanced. This repo has live evidence of exactly that class (an unsound KV claim, a
# fluent `Register Register Register...` loop at temperature=0 where the recomputed answer
# was correct, 2026-10-06). OUTPUT CANNOT BE THE WITNESS. So the witness is an exception
# with the row and the block id in its message.

# ---- THE SITES, AS THEY ACTUALLY ARE (three corrections to the brief) -----
# COMMIT SITE. The brief said "`commit_recoverssm_state` in the model-state path under
# `v1/worker/gpu/`". There is no such method under `v1/worker/gpu/`. `grep -rn "def
# commit_recoverssm_state"` in the v2.5.1 tree finds FOUR, all on ATTENTION METADATA
# classes: `v1/attention/backends/recoverssm_metadata.py`, `.../gdn_recoverssm.py`,
# `.../ple_recoverssm.py`, `models/kimi_k3/nvidia/kda_metadata.py`. The thing under
# `v1/worker/gpu/` that COMMITS the step - the only caller of all four - is
# `RecoverSSMState.commit_step` in `vllm/v1/worker/gpu/model_states/recoverssm.py`,
# reached from `MambaHybridModelState.postprocess_state` in the sibling `mamba_hybrid.py`.
# So: the CHECK goes in `commit_step` (ahead of its commit loop, so a collision stops the
# step BEFORE any state is written), and the row -> block RESOLUTION goes in
# `postprocess_state`, which is where the block tables live.
#
# LOAD-SUBMIT SITE. `post_forward` is the CONNECTOR's method, called by the runner at
# `v1/worker/gpu/model_runner.py` (three call sites); the worker-side submit it drives is
# `SimpleCPUOffloadWorker.start_load_kv` in `v1/simple_kv_offload/worker.py`, whose own
# comment says "Invoked after the forward launch on steps without sync loads
# (SchedulerOutput.has_sync_kv_loads)" - the deferred async load, exactly as described.
# The ids to intersect there are `SimpleCPUOffloadMetadata.load_gpu_blocks`.
#
# RE-READ ON THE BOX 2026-10-22, because the brief's two site paths were both wrong
# once already and this one was imprecise too. The runner never calls `start_load_kv`
# itself (it has no such call). The funnel is `ActiveKVConnector` in
# `v1/worker/gpu/kv_connector.py`: `pre_forward` binds the metadata and launches
# immediately when `scheduler_output.has_sync_kv_loads`, otherwise it defers to
# `post_forward`, and BOTH branches run through the one private method
# `ActiveKVConnector._start_load_kv`, which calls
# `SimpleCPUOffloadConnector.start_load_kv` -> `SimpleCPUOffloadWorker.start_load_kv`,
# where `backend.launch_copy(metadata.load_cpu_blocks, metadata.load_gpu_blocks,
# is_store=False, ...)` is the copy. So the publish sits in `_start_load_kv` (one
# site, both load paths, and the `no_forward` path, which reaches the launch through
# `pre_forward`), and the ids are captured in `pre_forward` where the metadata object
# is in hand. `get_kv_connector(...)` is called from exactly one place
# (`GPUModelRunner.initialize_kv_cache`, which the worker reaches after `load_model`,
# so `self.model_state` exists there) - which is why the sink registration is one
# line in `model_runner.py.patch` and why no other caller needed touching.
# There is NO `_handle_failed_recving` on the worker side: that method is
# `v1/core/sched/scheduler.py`'s, a different process. What reaches this process is
# `transfer_results.finished_recving` / `.failed_recving`.
#
# `TransferMeta.gpu_block_ids` IS the right thing, but it is the SCHEDULER-side name:
# `v1/simple_kv_offload/manager.py` does `load_gpu.extend(load_state.transfer_meta
# .gpu_block_ids)`, and that list becomes `load_gpu_blocks` on the worker. Intersecting
# the scheduler's field from the worker would be reading the wrong process.
#
# `_mamba_state_idx_gpu` IS per-row and reachable, but it is a block-table COLUMN, not a
# block id - the align kernel stores
# `min(max(num_computed + num_sampled - 1, 0) // MAMBA_BLOCK_SIZE, width - 1)`. Comparing
# it to a connector block id would compare two different namespaces and produce false
# positives AND false negatives at once. The real block id is
# `block_tables[gid][row, state_idx[row]]`, and the hunk in `mamba_hybrid.py` resolves
# exactly that, for every mamba group.

# ---- WHAT THE ASSERTION INTERSECTS, AND ITS COST ---------------------------
# Two HOST-SIDE id collections: the `(row, state block id)` pairs published by
# `publish_state_blocks` (resolved from the persistent per-req-slot tables the align
# post-process already uses), and the frozenset of the connector's in-flight destination
# block ids published by `publish_inflight_load_blocks`. The predicate is
# `find_load_collision`; the raising wrapper is `assert_no_load_collision`; both live in
# `RecoverSSMState`, so `kvtier-patch.sh`'s AST fingerprinter can hash them (they are
# METHOD bodies, not module-level functions - see the fingerprint section).
# MEASURED (this host, python 3.14.7, 200k calls; the predicate re-extracted from the
# shipped bytes and executed, which is what tests/
# test_recoverssm_load_collision_guard.py does, so the numbers price the code that ships):
#     guard not armed (no load in flight)      0.050 us/call   <- the per-step cost
#     64 rows committed,   320 ids in flight   2.221 us/call
#     512 rows committed,  320 ids in flight  10.647 us/call
#     512 rows committed, 4096 ids in flight  13.880 us/call
#     tracemalloc peak over 20,000 no-collision calls: 112 bytes (no per-step set)
# A set intersection was rejected on purpose: `set(committed.values()) & inflight`
# allocates on every call and loses the row the message has to name, so the shipped loop
# does one O(1) membership test per committed row and returns the first hit.
# The armed path ALSO pays the resolution: one masked select, one gather, and TWO
# `.tolist()` transfers in `mamba_hybrid.py`. That is reasoned, not measured - it needs
# tensors and a real block-table set, which nothing here can boot. Its exposure is
# bounded by design: `guard_armed()` is False on a step with no connector load, so the
# only steps that pay it are steps that also carry a load, which are the steps the guard
# exists for and a small minority of them. The plugin's dev-door lesson (a handler that
# slept 3 s on the EngineCore loop stalled serving 3.01 s per call) is the reason the
# unarmed step costs one attribute read and nothing else.

# ---- THE RESIDUAL QUESTION THIS CONVERTS FROM SILENT TO LOUD ---------------
# `--pipeline-parallel-size 2` is how this box boots (`serve-v2.2.sh`: TP=2, PP=2).
# `_preempt_request` took a `drop_stale_output` argument explicitly for "connectors with a
# pending KV hand-off, which the preemption's block free would leave without valid KV" -
# so the author DID consider preemption-plus-connector, and did not consider RecoverSSM
# rows. `RecoverSSMState.detach_step` / `restore_step` hold a commit for pp_size steps and
# defend it with ROW MASKING ("masks freed rows", and the deferred branch zeroes
# `num_sampled` where `idx_mapping < 0`). If a freed row index is reused by a LOADED
# request inside that window, masking is the only defence, and it could not be proven
# safe from source.
# What this draft makes provable at runtime: a collision between a committing row's state
# block and a load in flight. What it does NOT make provable: whether a PP-deferred commit
# writes the block published for it two steps earlier. The wiring names the row's CURRENT
# state block, which is the right thing to intersect with a live load but is not a proof
# about the deferred write. That gap is stated in the wiring hunk's own docstring so it
# cannot be read as coverage later.

# ---- WHAT IS MISSING, AND WHAT NOW EXISTS ----------------------------------
# CLOSED (2026-10-22): the publish, and the un-publish. `kv_connector.py.patch`
# captures `load_gpu_blocks` in `pre_forward`, publishes the union in
# `_start_load_kv` BEFORE the copy is launched, and retires it in `post_forward`
# from the same `transfer_results` the output is built from.
#
# IS THERE A RELIABLE UN-PUBLISH POINT? YES, and it is the engine's own verdict,
# not a guess. This connector has no per-transfer callback: `get_finished` polls the
# copy stream's events and resolves the completed event index through
# `SimpleCPUOffloadMetadata.load_event_to_reqs`, which is exactly why the capture
# keeps the requests an event carries alongside its ids. An event retires when
# EVERY request it names has been reported finished - and a FAILED load is
# reported finished too (the base class's own contract; the bad blocks are named
# separately by `get_block_ids_with_load_errors`), with `failed_recving` honoured
# the same way. So "in flight" means "not yet proven to have stopped writing",
# which is what the guard needs; clearing per step would NOT be, because the async
# path launches after this step's commit and the collision lands a later step.
# The one gap: an event whose request set came back EMPTY has no proof available
# by construction (the scheduler only allocates an event when it has requests, so
# this should be unreachable), so it is bounded at
# `KVTIER_LOAD_INFLIGHT_MAX_SUBMITS` (32 submits) and counted as
# `expired_unproven`. Expiry is an UNDER-report - the dangerous direction - which
# is why it is a counter and not a comment.
#
# STILL MISSING, in order:
#   a. NO READER INSIDE THE PLUGIN. The counters and the verdict go to a witness
#      file (`recoverssm-guard-<rank>.json` under `VLLM_E2_TIER_DIAG`, `/tmp` when
#      unset) and to one WARNING line at first arming, which the proxy already
#      ingests into `logs.db`. Wiring it through `/plugins/kvtier/*` is a plugin
#      change, not an engine one, and is deliberately NOT done here: the dev-door
#      handler runs on the EngineCore loop, so a new verb is its own review. Until
#      it exists, an operator proves the guard live from the file/log, and the
#      three states stay distinguishable because the file carries `verdict`:
#      absent = no load submit has ever run in this process (NOT "clean boot"),
#      `guard_not_armed_no_recover_ssm_sink` = loads ran with no RecoverSSM to
#      arm, `armed_no_load_submit_yet` = armed and idle, `armed_loads_observed`
#      = the guard has had something to check.
#   b. THE COMMIT-SIDE PREDICATE'S OWN INVOCATION COUNT is not observable from
#      here - it runs inside `commit_step`, which this hunk does not touch. The
#      witness counts the LOAD side (`checks_at_submit`: submits that could reach
#      the predicate because the commit side had published) and the armings, and
#      says nothing it cannot see. Naming it beats a number that looks total.
#   c. THE TOOL CANNOT CARRY FOUR FILES (promotion item 2), and the ACCEPTANCE
#      BOOT HAS NEVER BEEN GRADED (item 4). Neither is closed by this hunk.

# ---- WHAT THIS DELIBERATELY DOES NOT DO ------------------------------------
# It does not lift the validator clause (DRAFT-0006 owns that, and its own blocker is the
# call-site enumeration). It does not make the pair SAFE; it makes one failure mode LOUD.
# It is behaviour-neutral for unflagged traffic on its own: no new work runs on a step
# unless the guard is armed. That sentence is now TRUE IN FACT RATHER THAN VACUOUSLY -
# the guard arms when a load is in flight, so the neutrality has to be argued, and it is
# argued by the measured cost below plus the fact that the sink push only ever hands
# over host-side ints.

# ---- which tree this entry describes ----------------------------------------
# v2.5.1 ONLY. RecoverSSM, `--use-replayssm` and the align-state machinery are v2.5
# concepts (fork 0071/0072/0085/0091); `model_states/recoverssm.py` does not exist in the
# v2.2 tree, so there is no v2.2 record to write and inventing one would be a fabricated
# reference - the exact thing `verify` exists to refuse.
trees="v2.5.1"
tree_default=v2.5.1

# ---- what is patched, and where (PRIMARY file) ------------------------------
# The five verdict-bearing values (target_abs, git_root, engine_python, file_sha_pre,
# file_sha_post) are NEVER inherited from the flat keys, so all five are explicit below.
module=vllm.v1.worker.gpu.model_states.recoverssm
klass=RecoverSSMState
git_rel=vllm/v1/worker/gpu/model_states/recoverssm.py
target_mode=UNKNOWN
tree_v2_5_1_target_abs=/home/user/vllm-38-next-v2.5/vllm-v2.5/vllm/v1/worker/gpu/model_states/recoverssm.py
tree_v2_5_1_git_root=/home/user/vllm-38-next-v2.5/vllm-v2.5
tree_v2_5_1_engine_python=/home/user/vllm-38-next-v2.5/venv-v2.5/bin/python
# Read read-only on the box 2026-10-22: `sha256sum` of the installed file, AND the same
# digest returned by the engine interpreter when it read the file itself, AND the digest
# of the copy scp'd into the local scratch tree - three reads, one value. NOT the
# production tree: the engine SERVING is /home/user/vllm-38-next/vllm-workspace, which
# this entry never reads, scans or touches.
tree_v2_5_1_file_sha_pre=06f9e733f583a35a9b1c1977baedaf4a5af0fccf5235901d812935788f7dd954
# NOT A GUESS, and the build path is the tool's own: `git apply --check -p1` clean at zero
# offset on a freshly scp'd pristine pre-image, then `git apply -p1`, then the resulting
# image compiled by the ENGINE interpreter (base64 in argv, stdin-piped program, nothing
# written to the box - the interpreter itself re-reported this digest before printing
# `COMPILE ok`). The box's tree was NOT modified; the apply happened in a local scratch
# copy under /home/user/.tmp-kvtier.
tree_v2_5_1_file_sha_post=ed8e8c97488872a4f1682de0e2955dbec18d51f775eec980b1bea121cfa101c2
# LOWERCASE IS LOAD-BEARING, not style: `TREE_FIELDS` (kvtier-patch.sh:328) spells every
# field lowercase and `tree_field()` (:354) builds `local v="tree_$1_$2"` from it, so an
# upper-cased field suffix is a key the tool never reads and the tree answers "UNKNOWN
# PROVENANCE - no recorded reference". Worked example: 0003/.../patch.manifest:117-130.
tree_v2_5_1_target_mode=UNKNOWN
# `git -C /home/user/vllm-38-next-v2.5/vllm-v2.5 rev-parse HEAD`, read 2026-10-22; agrees
# with the pin DRAFT-0005/DRAFT-0006 carry, and `git status --porcelain` on both target
# files was EMPTY, so the pre-image below is HEAD's copy and not a hand-edit.
fork_pin_head=96a0d13b6e98ad4ef86e66a3f6ddb5dd9199a591
