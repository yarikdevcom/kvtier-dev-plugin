# ---- per-method fingerprints (PRIMARY file) ---------------------------------
# All three are methods that ALREADY EXIST and are MODIFIED, so a pre-image hash exists
# for each; the NEW members (`find_load_collision`, `assert_no_load_collision`,
# `guard_armed`, `publish_state_blocks`, `publish_inflight_load_blocks`) have no pre-image
# by definition and are carried by the whole-file hashes instead.
# PRE values: computed by the tool's own AST algorithm (klass walk, body from
# decorator-or-def through `end_lineno`) run by the ENGINE interpreter against the box's
# real file. POST values: the identical algorithm against the locally-applied image whose
# digest the engine interpreter confirmed before compiling it. Local python was 3.14.7 for
# the POST run, so a promotion must let the tool re-read them with 3.13.5 - cross-checked
# here by running the same program on the PRE image under BOTH interpreters and getting
# the same three digests, which is what makes the POST digests trustworthy.
methods="commit_step __init__ reset"
methods_pre_sha256="da8b5404e37e167a6bf6430698c5760d628a4ed95970486732df66217814001d bc685873624d0e182ace306c004293da8befff9b73ea8b1990e8f7d1deafba94 117d6ce24975098c5efc57ac47927aae96531343ea214f1d1423188e18b1d82d"
methods_post_sha256="03e879fc160d9c49fb1fb0214495e2dbeb8c595594ff53a4b67003607f9b2d54 b4aa09156c2d56d6f60267aeb102a0e799490e73465cf00669bc5804c2296d37 99803546a280488246ed6a732ef2d3b3e5ab33ecdc70d7dbb39eafedc010faa2"

# ---- THE SECOND FILE, WHICH THIS SCHEMA CANNOT HOLD -------------------------
# `mamba_hybrid.py.patch` sits beside the primary patch. It resolves `(row, state block
# id)` pairs in `MambaHybridModelState.postprocess_state` and publishes them. Its own
# record, for the day the tool can carry it (NOT a substitute for the keys above):
#   file             vllm/v1/worker/gpu/model_states/mamba_hybrid.py
