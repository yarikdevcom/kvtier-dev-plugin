#                    (same build path as above, same engine-interpreter compile check)
#   bytes / lines    19907 -> 22725  /  455 -> 503
#   methods          postprocess_state
#   methods_pre      3e87c91273108f8a449bea872650a22770f3ef1c37d1b665041715ae9b134b02
#                    (engine interpreter, box file)
#   methods_post     e10e5db083628fe7ba27c94be55e5e68228c714bd287fe5795b1c602c2f441bf
