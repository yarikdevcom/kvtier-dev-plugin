+# How many load submits an outstanding destination set may survive without its
+# completion being PROVEN before it is dropped. By construction a load event
+# always names the requests it carries, so completion is provable for every
+# event this file publishes and this bound should never fire; it exists because
+# an unbounded set is a guard that fires later for a reason nobody can trace.
+# Dropping one is an UNDER-report, the dangerous direction, so it is counted
+# (`expired_unproven`) rather than absorbed.
+KVTIER_LOAD_INFLIGHT_MAX_SUBMITS = 32
+
+# Re-write the counter file at most this often per change burst, so a boot that
+# loads every step cannot turn a diagnostic into per-step file I/O.
+KVTIER_GUARD_WITNESS_EVERY = 64
