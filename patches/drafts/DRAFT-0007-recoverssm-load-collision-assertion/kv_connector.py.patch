+    # ---- RecoverSSM / KV-connector collision guard: the LOAD side -------------
+    # (DRAFT-0007.) The predicate and the raise live in `RecoverSSMState`; this
+    # half only publishes where the connector's loads are going. Everything here
+    # is host-side: the ids arrive as ints on a metadata object the connector
+    # already holds, and the union is a set union of small int sets.
+
+    def set_load_collision_sink(self, model_state: Any) -> None:
+        """Register the guard's other half; called once, by the model runner.
+
+        The guard lives on the model state's `recoverssm` member, which is None
+        unless `--use-replayssm` is on. A model with no RecoverSSM registers
+        nothing and this connector keeps counting without ever pushing - and
+        says so in the witness, because a counter that reads zero must never be
+        readable as "the guard ran and found nothing".
+        """
+        sink = getattr(model_state, "recoverssm", None)
+        if not hasattr(sink, "publish_inflight_load_blocks"):
+            sink = None
+        self._kvtier_guard_sink = sink
+        logger.info(
+            "RECOVERSSM-GUARD load side registered: sink=%s; the guard is armed "
+            "from the first load submit, not from this line",
+            type(sink).__name__ if sink is not None else "none",
+        )
+        self._kvtier_write_guard_witness(force=True)
+
+    def _kvtier_capture_load_submit(self, metadata: Any) -> None:
+        """Remember where this step's load lands, before anything is launched.
+
+        The ids are read off the SAME object the copy is launched from:
+        `load_gpu_blocks` is the worker-side landing spot of the scheduler's
+        `TransferMeta.gpu_block_ids` (the manager does
+        `load_gpu.extend(load_state.transfer_meta.gpu_block_ids)`), so this is
+        the destination set as the submit itself sees it, not a re-derivation of
+        it. `load_event_to_reqs` is kept alongside because completion arrives as
+        REQUEST ids - the worker polls the copy stream's events and resolves
+        them through that same map, and nothing else in this process can tie a
+        finished request back to a load event.
+        """
+        ids = getattr(metadata, "load_gpu_blocks", None)
+        event = getattr(metadata, "load_event", -1)
+        if not ids or event is None or event < 0:
+            # Nothing to load this step. A previous step's note must not
+            # survive: the next submit would publish it as if it were that
+            # submit's own destination, which is a false alarm waiting for a
+            # colliding commit.
+            if self._kvtier_pending_load is not None:
+                self._kvtier_guard_counters["pending_replaced"] += 1
+            self._kvtier_pending_load = None
+            return
+        by_event = getattr(metadata, "load_event_to_reqs", None) or {}
+        # A MUTABLE set on purpose: `_kvtier_retire_completed` shrinks it as the
+        # requests it names are reported finished, and the event retires when it
+        # runs empty.
+        self._kvtier_pending_load = (int(event), frozenset(ids), set(by_event.get(event, ())))
+
+    def _kvtier_publish_inflight_loads(self) -> None:
+        """At the submit: the pending note becomes in-flight, and the guard gets
+        the new union.
+
+        A load's ids must stay published until its completion is PROVEN, not
+        merely until the next step: the async path launches after this step's
+        RecoverSSM commit, so the collision this guard exists to catch is one
+        this step cannot see. Clearing per step would therefore be the silent
+        direction of wrong.
+        """
+        outstanding = self._kvtier_inflight_loads
+        if outstanding:
+            aged = {}
+            for event, (ids, reqs, seen) in outstanding.items():
+                if seen + 1 >= KVTIER_LOAD_INFLIGHT_MAX_SUBMITS:
+                    # No completion proof ever arrived for it. Dropping is an
+                    # under-report and is counted, never absorbed.
+                    self._kvtier_guard_counters["expired_unproven"] += 1
+                    continue
+                aged[event] = (ids, reqs, seen + 1)
+            self._kvtier_inflight_loads = outstanding = aged
+        pending = self._kvtier_pending_load
+        self._kvtier_pending_load = None
+        if pending is not None:
+            event, ids, reqs = pending
+            outstanding[event] = (ids, reqs, 0)
+            self._kvtier_guard_counters["publishes"] += 1
+            self._kvtier_witness_changes += 1
+            if not reqs:
+                # The scheduler only allocates a load event when it has requests
+                # to load, so an event naming none has no completion proof
+                # available and can only expire. Counted, so a future change
+                # that makes it common is visible instead of quietly expiring.
+                self._kvtier_guard_counters["unprovable_events"] += 1
+            self._kvtier_push_guard()
+
+    def _kvtier_retire_completed(
+        self, finished_recving: Any, failed_recving: Any
+    ) -> None:
+        """Un-publish the events whose copies are over - loaded or failed.
+
+        The only per-transfer completion signal that reaches this process is
+        `get_transfer_results()`'s finished/failed recving, which names
+        REQUESTS: `get_finished()` polls the copy stream's events and resolves
+        them through `load_event_to_reqs`. A failed load is reported as finished
+        recving as well (the base class's own contract, and
+        `get_block_ids_with_load_errors()` is how the bad blocks are named),
+        while `failed_recving` is what the scheduler feeds
+        `Scheduler._handle_failed_recving`. Honouring both is the honest
+        definition of "this copy will write nothing more", which is all the
+        guard needs. There is no per-transfer callback in this connector, and
+        this is the closest thing to one that exists.
+
+        An event is retired only once EVERY request it carries has been seen
+        finished. The engine reports an event's requests together (it resolves
+        the completed event index through `load_event_to_reqs`), but the
+        remaining set is kept per event so a report that arrives split across
+        steps still retires, instead of leaving a live transfer armed until it
+        expires.
+        """
+        outstanding = self._kvtier_inflight_loads
+        if not outstanding:
+            return
+        done = set(finished_recving or ()) | set(failed_recving or ())
+        if not done:
+            return
+        retired = []
+        for event, (_ids, remaining, _seen) in outstanding.items():
+            if not remaining:
+                continue
+            remaining -= done
+            if not remaining:
+                retired.append(event)
+        for event in retired:
+            del outstanding[event]
+        if retired:
+            self._kvtier_guard_counters["unpublishes"] += len(retired)
+            self._kvtier_witness_changes += 1
+            self._kvtier_push_guard()
+
+    def _kvtier_push_guard(self) -> None:
+        """Hand the sink the union of everything still in flight.
+
+        The call is the disarm path too: an empty union is what turns
+        `guard_armed()` off again, so a step with no load resolves nothing on
+        the model-state side.
+        """
+        union: frozenset = frozenset()
+        for ids, _reqs, _seen in self._kvtier_inflight_loads.values():
+            union = union | ids
+        sink = self._kvtier_guard_sink
+        if sink is not None:
+            self._kvtier_guard_counters["pushes_to_guard"] += 1
+            # The predicate runs inside the sink when BOTH sides are non-empty,
+            # and the other side is the sink's own state, so counting it needs
+            # this read. It is the attribute the DRAFT-0007 hunk declares; if it
+            # is ever renamed the counter degrades to `state_side_unknown`
+            # instead of reporting a suspicious zero.
+            if union and hasattr(sink, "_state_blocks"):
+                if sink._state_blocks:
+                    self._kvtier_guard_counters["checks_at_submit"] += 1
+            else:
+                self._kvtier_guard_counters["state_side_unknown"] += 1
+            if union and not self._kvtier_guard_armed_logged:
+                self._kvtier_guard_armed_logged = True
+                logger.warning(
+                    "RECOVERSSM-GUARD ARMED: %d destination blocks in flight; the "
+                    "commit-side intersection now runs on every RecoverSSM commit "
+                    "(witness: %s)",
+                    len(union),
+                    self._kvtier_guard_witness_path(),
+                )
+            # NOT inside try/except, deliberately: a collision is the one
+            # exception this path must let through, and it must reach the step
+            # loop as itself rather than as a swallowed log line.
+            sink.publish_inflight_load_blocks(union, side="load_submit")
+        self._kvtier_write_guard_witness()
+
+    def _kvtier_guard_witness_path(self) -> str:
+        """Where this process publishes its guard counters.
+
+        `VLLM_E2_TIER_DIAG` is the directory the operator already reads for
+        tier diagnostics; with it unset the witness falls back to `/tmp` rather
+        than vanishing, since "no file" is supposed to mean "no load submit has
+        ever run here", not "the diagnostics directory was not configured".
+        The name never starts with `rank-`, so it cannot be mistaken for a rank
+        document by the reader that walks that directory.
+        """
+        if self._kvtier_guard_rank_tag is None:
+            try:
+                from vllm.distributed.parallel_state import (
+                    get_pp_group,
+                    get_tp_group,
+                )
+
+                tag = (
+                    f"PP{get_pp_group().rank_in_group}"
+                    f"_TP{get_tp_group().rank_in_group}"
+                )
+            except Exception:  # pragma: no cover - only before distributed init
+                tag = f"pid{os.getpid()}"
+            self._kvtier_guard_rank_tag = tag
+        directory = (os.environ.get("VLLM_E2_TIER_DIAG") or "/tmp").strip() or "/tmp"
+        return os.path.join(
+            directory, f"recoverssm-guard-{self._kvtier_guard_rank_tag}.json"
+        )
+
+    def _kvtier_write_guard_witness(self, force: bool = False) -> None:
+        """Publish the guard's counters outside the process.
+
+        A diagnostic must never break serving, so every failure here is caught -
+        and counted, because a witness that silently stopped being written is
+        how "armed, no collisions" turns into an assumption. It is SAMPLED (a
+        rewrite at most every `KVTIER_GUARD_WITNESS_EVERY` changes, or whenever
+        the outstanding-event count moves), so it is a live view of the
+        counters, not an event log.
+
+        `verdict` is written down because the three states a reader must tell
+        apart do not differ in any number: a file that is absent means no load
+        submit has ever run in this process; `sink: null` means loads ran with
+        no RecoverSSM guard to arm; `publishes: 0` with a sink means armed and
+        never yet given anything to check.
+        """
+        outstanding = len(self._kvtier_inflight_loads)
+        due = (
+            force
+            or outstanding != self._kvtier_witness_events
+            or self._kvtier_witness_changes >= KVTIER_GUARD_WITNESS_EVERY
+        )
+        if not due:
+            return
+        self._kvtier_witness_events = outstanding
+        self._kvtier_witness_changes = 0
+        counters = self._kvtier_guard_counters
+        sink = self._kvtier_guard_sink
+        if sink is None:
+            verdict = "guard_not_armed_no_recover_ssm_sink"
+        elif not counters["publishes"]:
+            verdict = "armed_no_load_submit_yet"
+        else:
+            verdict = "armed_loads_observed"
+        payload = {
+            "kind": "kvtier-recoverssm-guard",
+            "verdict": verdict,
+            "sink": type(sink).__name__ if sink is not None else None,
+            "pid": os.getpid(),
+            "in_flight_events": outstanding,
+            "in_flight_blocks": sum(
+                len(ids) for ids, _reqs, _seen in self._kvtier_inflight_loads.values()
+            ),
+            "counters": dict(counters),
+            "max_submits_before_expiry": KVTIER_LOAD_INFLIGHT_MAX_SUBMITS,
+            "meaning": (
+                "publishes counts load submits that added destination blocks; "
+                "unpublishes counts events whose completion was proven; "
+                "expired_unproven counts sets dropped with no proof, which is an "
+                "UNDER-report and must stay 0; checks_at_submit counts submits "
+                "that could reach the predicate because the commit side had "
+                "published. Absent file = no load submit ever ran in this "
+                "process, which is NOT the same claim as a collision-free boot."
+            ),
+        }
+        path = self._kvtier_guard_witness_path()
+        tmp = f"{path}.{os.getpid()}.tmp"
+        try:
+            with open(tmp, "w", encoding="utf-8") as handle:
+                json.dump(payload, handle, sort_keys=True)
+                handle.flush()
+            os.replace(tmp, path)
+            counters["witness_writes"] += 1
+        except (OSError, TypeError, ValueError):
+            # A diagnostic never outranks serving. Counted, and said once.
+            counters["witness_write_failures"] += 1
+            if counters["witness_write_failures"] == 1:
+                # No `exc_info`: this block must not be able to raise, and a
+                # logging call that formats an traceback is one way it could.
+                # The failure is a counter, and the path it failed on.
+                logger.warning(
+                    "RECOVERSSM-GUARD witness could not be written to %s; the "
+                    "counters below are still correct in memory", path,
+                )
+
 
 NO_OP_KV_CONNECTOR = KVConnector()
 
