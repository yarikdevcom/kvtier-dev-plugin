# below. NOT a production file: this is the v2.5 experiment tree, and the engine actually
# serving is the v2.2 tree at /home/user/vllm-38-next/vllm-workspace.
tree_v2_5_1_file_sha_pre=c2a70ce5dd70e2b8e71b29f5cdd5a153693b651058cf7d4a760bbf2465ce030a
