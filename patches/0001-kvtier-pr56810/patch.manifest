# CANONICAL HOME of these bytes: this repo's `patches/` directory (see
# patches/README.md for the base commit, the 58-patch packaging series and the
# tree hashes). TWO consumers, one set of bytes: `patches/apply-kvtier-patches.sh`
# applies them to a LOCAL vLLM checkout, and llm-api's `config/box/kvtier-patch.sh`
# carries them to the GPU box over SSH (it resolves this directory from
# KVTIER_PLUGIN_REPO and holds no copy of its own). Edit here, never there.
# Tracked metadata for the patch in this directory. SOURCED by kvtier-patch.sh -
# keep it shell-parseable (KEY=value, no command substitution, no trailing spaces)
# and keep it byte-honest: every hash here is what `verify` compares the box
# against, so a wrong value fails closed (the tool refuses) rather than open.
#
# How these values were produced (all reproducible, none from memory):
#   file_sha_pre   sha256 of the fork's manager.py at fork_pin_head, which is
#                  ALSO the installed file on the box AND the committed HEAD blob
#                  of that path in the box's own checkout (all three verified
#                  equal on 2026-10-05 before this file was written).
#   patch_file     generated by `git diff --no-index` between the pre-image and
#                  the pre-image with upstream's manager.py hunk applied; applies
#                  with `git apply -p1` (and GNU `patch -p1`) at ZERO offset and
#                  reproduces file_sha_post exactly.
#   file_sha_post  sha256 of that applied result.
#   method_*_sha256  sha256 of inspect.getsource()-equivalent method text
#                  (4-space class-body indent included, decorators included),
#                  extracted with `ast` - i.e. the SAME quantity
#                  kvtier_dev_plugin/backport.py fingerprints at runtime. The
#                  post values are byte-identical to
#                  kvtier_dev_plugin/pr56810_sources.py SOURCES[name]["source"],
#                  which is the runtime backport's proven-byte-identical copy.

patch_id=pr56810
title="PR 56810: honour prefix_cacheable_group_ids in SimpleCPUOffloadScheduler"
upstream_issue=vllm-project/vllm#56396
upstream_pr=vllm-project/vllm#56810
symptom="assert block_size % hash_block_size == 0 on the FIRST store request, for a hybrid model whose scratch/QSA group block size does not divide the hash block size"

# ---- what is patched, and where (absolute: it lives in an EDITABLE install) --
# vllm is `pip install -e` on the box: site-packages holds only the .pth + the
# editable finder + the dist-info, and the engine imports the package from this
# git checkout. Patching it therefore edits a git working tree, which is exactly
# why DIVERGENCE below is reported from git itself and not from a tool-local claim.
target_abs=/home/user/vllm-38-next/vllm-workspace/vllm/v1/simple_kv_offload/manager.py
target_mode=664
module=vllm.v1.simple_kv_offload.manager
klass=SimpleCPUOffloadScheduler

# The checkout the editable install resolves to, and the path inside it (used to
# make the divergence from the fork's own commit explicit and auditable).
git_root=/home/user/vllm-38-next/vllm-workspace
git_rel=vllm/v1/simple_kv_offload/manager.py
fork_version=0.30.0
fork_pin_head=10b8e073321f22113da977856b5d5593ab6fa5d5

# The interpreter the engine itself runs on. Every apply-time check (py_compile,
# the module import, the method-body hashes) uses THIS interpreter, never a
# system python: verifying a patched file with a different interpreter than the
# one that will import it proves nothing.
engine_python=/home/user/vllm-38-next/venv/bin/python

# ---- the patch itself -------------------------------------------------------
patch_file=manager.py.patch
patch_sha256=0e84e80664f4bb9337b61a6c47cbcbe351afe2166b153521b8c10fdcbd7601a5
patch_hunks=4
patch_added=9
patch_removed=1

# ---- whole-file fingerprints -----------------------------------------------
file_sha_pre=3cc841ff97e4ec237800d4f81dcb5dfb5191c639f275a32892915e8b1af43eb7
file_sha_post=e4b00291991cfd6fdcabb8a22379b119073fca63341d2f488954b280b4a996eb
file_bytes_pre=58865
file_bytes_post=59197
file_lines_pre=1368
file_lines_post=1376

# ---- per-method fingerprints, order-aligned, space-separated ----------------
# These are what make a PARTIAL patch visible: the whole-file hash says
# "neither state", and only these four say WHICH method did not land.
# Quoted because this file is SOURCED by the tool: an unquoted multi-word value
# is a command name to the shell, and the tool would start with five errors.
methods="__init__ _estimate_lazy_target_blocks update_state_after_alloc _select_eager_blocks_to_store"
methods_pre_sha256="12c3a9c52f1b0d0ef03e07a0d19a67433829ff65bb3bfd2969d3e2dcbe366925 dac52a01e42095cbb6c852859c3439307dcf539ac32c8d690e19ae5f2400f735 ed45065111c1e287e921162f7f38da6ae7c368100c5dfa0b999b6c68b2a391ec 12b3854a8dcfb55330db95141fb4ce910222f67ea0fac1a5899832360c236187"
methods_post_sha256="70cea026db307075bf736554c5b6eace54017fc977898093579568d89fa8c21a 21e73419defaae87ec69d79e820ba3c61843d6dcdccec070c95042d00d16d9b2 f7543190de8e17e8ebe159a2fcc94ef04dcb4ade9dd64f7e146f7c1321eb4a51 d39d9df7f72e0dbff2508eed458843b99c6028b3a1c4b2cc09eebb1ab20c68f3"

# ---- where the tool records what it did, and where backups live -------------
# OUTSIDE the git checkout on purpose: a .bak littered inside the fork's tree is
# an untracked file in someone else's repository, and `git clean -fd` would take
# the rollback with it. Same <name>.<ts>-<tag>.bak naming as config/box's own
# backup convention, so an operator who knows one knows both.
state_dir=.kvtier-patch
backup_dir=kvtier-patch-backups
